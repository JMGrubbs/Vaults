# PostgreSQL container settings used by Docker Compose.
POSTGRES_MAIN_USER=postgres
POSTGRES_MAIN_PASSWORD=replace-with-a-strong-password
POSTGRES_MAIN_DB=postgres

# Reserved OAuth settings forwarded by Docker Compose to the backend.
# The OAuth/PKCE routes are not wired into the application yet.
AUTHORIZATION_CODE_EXPIRE_SECONDS=120
OAUTH_LOGIN_RATE_WINDOW_SECONDS=300
OAUTH_LOGIN_EMAIL_LIMIT=5
OAUTH_LOGIN_IP_LIMIT=300
