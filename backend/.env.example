# Backend runtime dependencies.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-password@postgres:5432/postgres
REDIS_URL=redis://db-cache:6379/0

# JWT and browser-session settings.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_KEY=auth_session

# Reserved OAuth settings. Docker Compose overrides these from the root .env.
# The OAuth/PKCE routes are not wired into the application yet.
AUTHORIZATION_CODE_EXPIRE_SECONDS=120
OAUTH_LOGIN_RATE_WINDOW_SECONDS=300
OAUTH_LOGIN_EMAIL_LIMIT=5
OAUTH_LOGIN_IP_LIMIT=300
