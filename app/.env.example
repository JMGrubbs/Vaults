DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/postgres"
REDIS_URL="redis://db-cache:6379/0"
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTHORIZATION_CODE_EXPIRE_SECONDS=120
OAUTH_LOGIN_RATE_WINDOW_SECONDS=300
OAUTH_LOGIN_EMAIL_LIMIT=5
OAUTH_LOGIN_IP_LIMIT=300
OAUTH_CLIENTS_JSON='[{"client_id":"example-app","name":"Example App","redirect_uris":["http://localhost:3000/auth/callback"]}]'
# Wildcard preserves the legacy API behavior; use exact origins in production.
CORS_ORIGINS_JSON='["*"]'
